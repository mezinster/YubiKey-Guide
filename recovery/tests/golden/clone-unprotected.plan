STEP 1 card1 <CARDHOME> gpgconf --kill all
STEP 2 card1 <CARDHOME> ykman --device <SERIAL1> openpgp reset -f
STEP 3 card1 <CARDHOME> gpgconf --kill all
STEP 4 card1 <CARDHOME> ykman --device <SERIAL1> openpgp access set-retries 5 5 5 -f -a <DEFAULT_ADMIN_PIN>
STEP 5 card1 <CARDHOME> gpgconf --kill all
STEP 6 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --change-pin
STDIN 3
STDIN <DEFAULT_ADMIN_PIN>
STDIN <ADMIN_PIN>
STDIN <ADMIN_PIN>
STDIN q
STEP 7 card1 <CARDHOME> gpgconf --kill all
STEP 8 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --change-pin
STDIN 1
STDIN <DEFAULT_USER_PIN>
STDIN <USER_PIN>
STDIN <USER_PIN>
STDIN q
STEP 9 card1 <CARDHOME> gpgconf --kill all
STEP 10 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --edit-card
STDIN admin
STDIN login
STDIN <LOGIN>
STDIN <ADMIN_PIN>
STDIN quit
STEP 11 card1 <CARDHOME> gpgconf --kill all
STEP 12 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --edit-key 6865D9F4DFD59938BD0BD28E5B03F9BEC018F22C
STDIN key 2CD59BE7DE042FD81FDEEAEF162CE50BCFB94787
STDIN keytocard
STDIN 1
STDIN <ADMIN_PIN>
STDIN save
STEP 13 card1 <CARDHOME> gpgconf --kill all
STEP 14 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --edit-key 6865D9F4DFD59938BD0BD28E5B03F9BEC018F22C
STDIN key BD0611610599040C5D5B59715E5D0A752D6291B1
STDIN keytocard
STDIN 2
STDIN <ADMIN_PIN>
STDIN save
STEP 15 card1 <CARDHOME> gpgconf --kill all
STEP 16 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --edit-key 6865D9F4DFD59938BD0BD28E5B03F9BEC018F22C
STDIN key 749F393B1F636B3B3E7C3AA6C6CABC1928DA4A0C
STDIN keytocard
STDIN 3
STDIN <ADMIN_PIN>
STDIN save
STEP 17 card1 <CARDHOME> gpgconf --kill all
STEP 18 card1 <CARDHOME> ykman --device <SERIAL1> openpgp keys set-touch sig on -f -a <ADMIN_PIN>
STEP 19 card1 <CARDHOME> gpgconf --kill all
STEP 20 card1 <CARDHOME> ykman --device <SERIAL1> openpgp keys set-touch dec on -f -a <ADMIN_PIN>
STEP 21 card1 <CARDHOME> gpgconf --kill all
STEP 22 card1 <CARDHOME> ykman --device <SERIAL1> openpgp keys set-touch aut on -f -a <ADMIN_PIN>
STEP 23 verify1 <STAGING> gpg --batch --yes --armor --output <VERIFYHOME>/pub.asc --export 6865D9F4DFD59938BD0BD28E5B03F9BEC018F22C
STEP 24 verify1 <VERIFYHOME> gpg --batch --import <VERIFYHOME>/pub.asc
STEP 25 verify1 <VERIFYHOME> gpg --batch --with-colons --card-status
CHECK cardstatus
STEP 26 verify1 <VERIFYHOME> gpg --batch --pinentry-mode loopback --passphrase-fd 0 --yes --local-user 2CD59BE7DE042FD81FDEEAEF162CE50BCFB94787! --output <VERIFYHOME>/test.sig --detach-sign <VERIFYHOME>/test.txt
STDIN <USER_PIN>
STEP 27 verify1 <VERIFYHOME> gpg --batch --verify <VERIFYHOME>/test.sig <VERIFYHOME>/test.txt
STEP 28 verify1 <VERIFYHOME> gpg --batch --yes --trust-model always --recipient BD0611610599040C5D5B59715E5D0A752D6291B1! --output <VERIFYHOME>/test.gpg --encrypt <VERIFYHOME>/test.txt
STEP 29 verify1 <VERIFYHOME> gpgconf --kill all
STEP 30 verify1 <VERIFYHOME> gpg --batch --pinentry-mode loopback --passphrase-fd 0 --yes --output <VERIFYHOME>/test.out --decrypt <VERIFYHOME>/test.gpg
STDIN <USER_PIN>
CHECK roundtrip
STEP 31 finish <STAGING> gpg --batch --yes --armor --output <OUT>/public-5B03F9BEC018F22C-<DATE>.asc --export 6865D9F4DFD59938BD0BD28E5B03F9BEC018F22C
STEP 32 finish <STAGING> gpg --batch --yes --output <OUT>/ssh-5B03F9BEC018F22C.pub --export-ssh-key 749F393B1F636B3B3E7C3AA6C6CABC1928DA4A0C!
