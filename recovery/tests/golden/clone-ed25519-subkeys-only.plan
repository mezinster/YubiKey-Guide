STEP 17 card1 <CARDHOME> gpgconf --kill all
STEP 18 card1 <CARDHOME> ykman --device <SERIAL1> openpgp keys set-touch sig on -f -a <ADMIN_PIN>
STEP 19 card1 <CARDHOME> gpgconf --kill all
STEP 20 card1 <CARDHOME> ykman --device <SERIAL1> openpgp keys set-touch dec on -f -a <ADMIN_PIN>
STEP 21 card1 <CARDHOME> gpgconf --kill all
STEP 22 card1 <CARDHOME> ykman --device <SERIAL1> openpgp keys set-touch aut on -f -a <ADMIN_PIN>
STEP 23 verify1 <STAGING> gpg --batch --yes --armor --output <VERIFYHOME>/pub.asc --export 6359B871334E108D81DA7EF884CA380EC0FAA9DB
STEP 24 verify1 <VERIFYHOME> gpg --batch --import <VERIFYHOME>/pub.asc
STEP 25 verify1 <VERIFYHOME> gpg --batch --with-colons --card-status
CHECK cardstatus
STEP 26 verify1 <VERIFYHOME> gpg --batch --pinentry-mode loopback --passphrase-fd 0 --yes --local-user 9418366136062EF6E76E67506A666220EEF5ACA5! --output <VERIFYHOME>/test.sig --detach-sign <VERIFYHOME>/test.txt
STDIN <USER_PIN>
STEP 27 verify1 <VERIFYHOME> gpg --batch --verify <VERIFYHOME>/test.sig <VERIFYHOME>/test.txt
STEP 28 verify1 <VERIFYHOME> gpg --batch --yes --trust-model always --recipient 745D18BD4FB8C9E3FE5D01A8336DE53966063C39! --output <VERIFYHOME>/test.gpg --encrypt <VERIFYHOME>/test.txt
STEP 29 verify1 <VERIFYHOME> gpgconf --kill all
STEP 30 verify1 <VERIFYHOME> gpg --batch --pinentry-mode loopback --passphrase-fd 0 --yes --output <VERIFYHOME>/test.out --decrypt <VERIFYHOME>/test.gpg
STDIN <USER_PIN>
CHECK roundtrip
STEP 31 finish <STAGING> gpg --batch --yes --armor --output <OUT>/public-84CA380EC0FAA9DB-<DATE>.asc --export 6359B871334E108D81DA7EF884CA380EC0FAA9DB
STEP 32 finish <STAGING> gpg --batch --yes --output <OUT>/ssh-84CA380EC0FAA9DB.pub --export-ssh-key B23457EB7EE88DFBF45F00ADCD572C3E70F342DD!
