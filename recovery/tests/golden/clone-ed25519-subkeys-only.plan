STEP 1 card1 <CARDHOME> gpgconf --kill all
STEP 2 card1 <CARDHOME> ykman --device <SERIAL1> openpgp reset -f
STEP 3 card1 <CARDHOME> gpgconf --kill all
STEP 4 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --change-pin
STDIN 3
STDIN <DEFAULT_ADMIN_PIN>
STDIN <ADMIN_PIN>
STDIN <ADMIN_PIN>
STDIN q
STEP 5 card1 <CARDHOME> gpgconf --kill all
STEP 6 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --change-pin
STDIN 1
STDIN <DEFAULT_USER_PIN>
STDIN <USER_PIN>
STDIN <USER_PIN>
STDIN q
STEP 7 card1 <CARDHOME> gpgconf --kill all
STEP 8 card1 <CARDHOME> ykman --device <SERIAL1> openpgp access set-retries 5 5 5 -f -a <ADMIN_PIN>
STEP 9 card1 <CARDHOME> gpgconf --kill all
STEP 10 card1 <CARDHOME> gpg --batch --command-fd 0 --pinentry-mode loopback --edit-card
STDIN admin
STDIN login
STDIN <LOGIN>
STDIN <ADMIN_PIN>
STDIN quit
