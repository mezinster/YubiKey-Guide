#!/usr/bin/env python3
"""Test double for gpg-connect-agent: records the commands and answers OK.

fail_at=learn answers like the real tool without a smartcard daemon: an ERR line and exit status 0.
"scd learn --force" prints the status lines in learn.txt (SERIALNO, KEYPAIRINFO) when that file exists.
"""

import os
import sys
from pathlib import Path

with open(Path(os.environ["FAKE_HW_DIR"]) / "calls.log", "a", encoding="utf-8") as f:
    f.write("gpg-connect-agent " + " | ".join(sys.argv[1:]) + "\n")
state = Path(os.environ["FAKE_HW_DIR"])
marker, wanted = state / "failed_once", state / "fail_at"
if "learn --force" in sys.argv[1:] and wanted.exists() and wanted.read_text().strip() == "learn" \
        and not marker.exists():
    marker.touch()
    print("ERR 67108983 No SmartCard daemon <SCD>")
    sys.exit(0)
if "scd learn --force" in sys.argv[1:] and (state / "learn.txt").exists():
    print((state / "learn.txt").read_text(), end="")
print("OK")
